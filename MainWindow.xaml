<Window x:Class="PPTLS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piedra, Papel, Tijera, Lagarto, Spock"
        Height="560"
        Width="480">

    <StackPanel Margin="20">

        <TextBlock Text="Piedra, Papel, Tijera, Lagarto, Spock"
                   FontSize="22"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,20"/>

//AGREGAR LOS DEMÁS ELEMENTOS

<TextBlock Text = "Hecho por: Sofia Padilla, Beatriz Garibaldi y Sebastian Venegas"
    FontSize = "10"
    TextWrapping = "Wrap"
    TextAlignment = "Center"
    >

<Button
    Width = "300"
    Height = "100"
    Click = "BtnPiedra_Click">
    <StackPanel>
        <TextBlock>Piedra</TextBlock>
        <Image Source = "Imagenes\Piedra.png">
    </StackPanel>
    <Button.Style>
        <Style TargetType = "Button">
            <Style.Triggers>
                <EventTrigger RoutedEvent = "Button.Click">
                    <EventTrigger.Actions>
                        <SoundPlayerAction Source = "Sonidos\">
                    </EventTrigger.Actions>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Button.Style>
</Button>

    </StackPanel>
</Window>